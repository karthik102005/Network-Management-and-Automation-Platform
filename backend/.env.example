# Local Development Environment Configuration Template
# Copy this file to .env in the backend directory and set your credentials.
# The .env file is git-ignored and will not be committed.

# Application Server Port (Render injects PORT dynamically; defaults to 8080 locally)
PORT=8080

# Option A: Local PostgreSQL Database (Default)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=network_management
DB_USERNAME=postgres
DB_PASSWORD=

# Option B: Hosted PostgreSQL Database (e.g., Neon PostgreSQL / Render)
# Set either SPRING_DATASOURCE_URL or DB_URL directly (e.g. from Neon dashboard)
# SPRING_DATASOURCE_URL=jdbc:postgresql://ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# SPRING_DATASOURCE_USERNAME=neondb_owner
# SPRING_DATASOURCE_PASSWORD=your_neon_password

# CORS Configuration
# Allowed origins for frontend requests (comma-separated if multiple)
# FRONTEND_URL=https://nmap-frontend.onrender.com
# CORS_ALLOWED_ORIGINS=https://nmap-frontend.onrender.com,http://localhost:5173
