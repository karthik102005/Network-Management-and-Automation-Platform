# Frontend Environment Configuration Template
# Copy this file to .env in the frontend directory for custom environment overrides.
# The .env file is git-ignored and will not be committed.

# Hosted Backend API Base URL (Render Web Service or custom domain)
# If omitted or left empty, the frontend defaults to '/api' which routes through the local Vite dev proxy.
# Example for production deployment on Render:
# VITE_API_BASE_URL=https://nmap-backend.onrender.com
